# Runtime configuration for this app.
# Copy to .env and fill in values. Never commit the real .env file — it is
# already gitignored.

# Required from Phase 3 onward: encrypts IPTV profile passwords at rest.
# Generate one with: openssl rand -base64 32
NUXT_PROFILE_ENCRYPTION_KEY=

# Optional: casting to a Chromecast. The app itself stays private to this computer;
# a second port on your home network serves only short-lived stream links to the TV.
# NUXT_CAST_PORT=3001          # 0 turns casting off
# NUXT_CAST_BASE_URL=          # override the detected http://<this computer's IP>:<port>
